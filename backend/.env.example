# --- Gemma inference on NVIDIA Brev (OpenAI-compatible) ---
# Base URL must include the /v1 suffix, e.g. https://<instance>.brevlab.com/v1
BREV_BASE_URL=
BREV_API_KEY=
BREV_MODEL=google/gemma-3-27b-it

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=claim_verifier

# --- Tools ---
SERPAPI_API_KEY=

# Leave empty to run the MCP server in-process (single-process demo).
# Set to http://localhost:9000/mcp when running `python -m backend.services.mcp.server`.
MCP_URL=

# --- Offline / demo switches ---
# Both default to auto: mocking turns on when the matching credential is missing.
MOCK_LLM=false
MOCK_SEARCH=false

# --- Workflow tuning ---
MAX_GATHER_STEPS=3
MAX_CLAIMS=4
