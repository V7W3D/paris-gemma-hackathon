# --- Gemma inference on NVIDIA Brev (OpenAI-compatible) ---
# Base URL must include the /v1 suffix, e.g. https://<instance>.brevlab.com/v1
BREV_BASE_URL=
BREV_API_KEY=
BREV_MODEL=google/gemma-3-27b-it

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=claim_verifier

# --- Alien MCP server (the evidence corpus) ---
# Streamable HTTP endpoint of your Alien MCP server. Empty means mocked retrieval.
ALIEN_MCP_URL=
ALIEN_MCP_TOKEN=
# Which advertised tool to search with. Empty means pick it from the tool list.
ALIEN_MCP_SEARCH_TOOL=
# JSON list of dataset ids, passed when the search tool accepts one.
ALIEN_DATASET_IDS=[]
ALIEN_SEARCH_LIMIT=8

# --- Offline / demo switches ---
# Both default to auto: mocking turns on when the matching credential is missing.
MOCK_LLM=false
MOCK_SEARCH=false

# --- Workflow tuning ---
MAX_GATHER_STEPS=3
MAX_CLAIMS=4
