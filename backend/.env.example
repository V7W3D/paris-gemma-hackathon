# --- Gemma inference (OpenAI-compatible: vLLM, Brev, …) ---
# Base URL must include the /v1 suffix.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=google/gemma-3-27b-it
# Legacy aliases (still accepted): BREV_BASE_URL, BREV_API_KEY, BREV_MODEL

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=claim_verifier

# --- Alien MCP server (the evidence corpus) ---
# Streamable HTTP endpoint of your Alien MCP server. Empty means mocked retrieval.
ALIEN_MCP_URL=https://biorxiv.mcp.alien.club/mcp
# The public Alien servers require a login. Either paste a bearer token here...
ALIEN_MCP_TOKEN=
# ...or leave it empty and let the browser flow run once:
#   python -m backend.scripts.alien_login
ALIEN_MCP_OAUTH=true
# Which advertised tool to search with. Empty means pick it from the tool list.
ALIEN_MCP_SEARCH_TOOL=
# JSON list of dataset ids, passed when the tool accepts one.
ALIEN_DATASET_IDS=[]
ALIEN_SEARCH_LIMIT=8

# --- Offline / demo switches ---
# Both default to auto: mocking turns on when the matching credential is missing.
MOCK_LLM=false
MOCK_SEARCH=false

# --- Workflow tuning ---
MAX_GATHER_STEPS=3
MAX_CLAIMS=4

# --- CORS (comma-separated origins; add your Vercel URL in production) ---
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-app.vercel.app"]
