# --- Gemma inference (OpenAI-compatible: vLLM, Brev, …) ---
# Base URL must include the /v1 suffix.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=google/gemma-3-27b-it
# Legacy aliases (still accepted): BREV_BASE_URL, BREV_API_KEY, BREV_MODEL

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=claim_verifier

# --- Offline / demo switches ---
# Mocking turns on when the matching credential is missing.
MOCK_LLM=false

# --- Workflow tuning ---
MAX_CLAIMS=4

# --- CORS (comma-separated origins; add your Vercel URL in production) ---
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-app.vercel.app"]
